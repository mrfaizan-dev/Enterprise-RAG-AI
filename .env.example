# ==========================================
# RAG AI API - Environment Variables Template
# Copy this file and rename it to ".env", then fill in your actual keys.
# ==========================================

# 1. Google Gemini API Key (Embeddings ke liye)
# Get your key from: https://aistudio.google.com/

GEMINI_API_KEY=your_google_gemini_api_key_here

# 2. Cohere API Key (Search results rerank karne ke liye)
# Get your key from: https://dashboard.cohere.com/

COHERE_API_KEY=your_cohere_api_key_here

# 3. Groq API Keys (LLM model ke liye)
# Get your key from: https://console.groq.com/

GROQ_API_KEYS=Enter Single your Api key here

# 4. Redis URL (Celery Background Tasks ke liye)
# Local setup ke liye default yehi rahega:

REDIS_URL=redis://localhost:6379/0
